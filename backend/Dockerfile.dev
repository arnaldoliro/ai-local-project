# Development image: dependencies are baked in, source code is bind-mounted
# by docker-compose.yml so `nest start --watch` reloads on every save.
FROM node:24-bookworm-slim

# - openssl: Prisma's schema engine (migrations) needs it.
# - procps (`ps`): `nest start --watch` kills the old process tree with
#   tree-kill, which shells out to `ps`. Without it only the wrapper shell
#   dies, the old Node process keeps port 3001 and every hot reload fails
#   with EADDRINUSE.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl procps \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node . .

EXPOSE 3001

# Apply pending migrations, regenerate the client, then start in watch mode.
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma generate && npm run start:dev"]
