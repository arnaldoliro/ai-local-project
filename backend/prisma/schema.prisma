// Prisma 7: the connection URL lives in prisma.config.ts, not here.
// Module format and import extensions are inferred from tsconfig.json (ESM).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  system
  user
  assistant
}

enum MessageStatus {
  streaming
  complete
  error
  aborted
}

model Conversation {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Generated by the model after the first exchange, or set by the user.
  title           String?
  /// Rolling summary of the messages that no longer fit in the context.
  summary         String?
  /// createdAt of the last message covered by `summary`. Newer messages are
  /// sent as history; older ones only reach the model through the summary.
  summarizedUntil DateTime? @map("summarized_until")
  /// Per-conversation settings. null = use the default (env model, default
  /// system prompt, the model's own temperature).
  model           String?
  systemPrompt    String?   @map("system_prompt")
  temperature     Float?
  /// Long-term memory: when false, this conversation neither searches
  /// memories nor is searchable from other conversations.
  memoryEnabled   Boolean   @default(true) @map("memory_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  messages        Message[]
  memoryChunks    MemoryChunk[]

  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// Model reasoning when thinking is enabled. Stored, but never sent back as context.
  thinking       String?
  /// Real token count reported by the model (usage), used to calibrate the estimator.
  tokenCount     Int?          @map("token_count")
  status         MessageStatus @default(complete)
  createdAt      DateTime      @default(now()) @map("created_at")
  attachments    Attachment[]
  /// On assistant messages: when the exchange it closes was indexed as memory.
  embeddedAt     DateTime?     @map("embedded_at")
  /// On assistant messages: which memories were injected to produce it.
  memories       Json?
  memoryChunks   MemoryChunk[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// An uploaded image. Uploaded first (messageId null), linked to the user
/// message when it is sent; never-linked uploads are cleaned up after 1 h.
model Attachment {
  id        String   @id @db.Uuid
  messageId String?  @map("message_id") @db.Uuid
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  width     Int
  height    Int
  /// File inside UPLOADS_DIR, always `<id>.<ext>`: never a user-provided name.
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("attachments")
}

/// A piece of a past exchange (user message + answer), embedded for search.
model MemoryChunk {
  id             String                 @id @default(uuid(7)) @db.Uuid
  conversationId String                 @map("conversation_id") @db.Uuid
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The assistant message that closes the exchange.
  messageId      String                 @map("message_id") @db.Uuid
  message        Message                @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content        String
  /// Written and searched with raw SQL: Prisma has no vector type.
  embedding      Unsupported("vector(1024)")
  /// Embedding model that produced the vector (vectors of different models
  /// are not comparable).
  model          String
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([messageId])
  @@map("memory_chunks")
}
