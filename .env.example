# Copy to .env and fill in. Never commit .env.

# --- Postgres (internal to the compose network, no published port) ---
POSTGRES_USER=ai_local
# Use only letters and digits: the value goes into a connection URL.
# Example to generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=ai_local

# --- Model ---
LLM_DEFAULT_MODEL=qwen3.5:2b
# Context window in tokens, applied to Ollama (OLLAMA_CONTEXT_LENGTH) and to
# the backend token budget. Do not raise it without measuring VRAM first.
LLM_CONTEXT_WINDOW=4096
# How long Ollama keeps an idle model in VRAM.
OLLAMA_KEEP_ALIVE=5m

# --- Generation limits ---
# Tokens reserved for each answer (thinking included, when enabled).
LLM_MAX_OUTPUT_TOKENS=1024
# Bigger reserve when thinking is on (reasoning counts as output). Those
# requests carry less history: 4096 - 2048 - 10% = ~1638 prompt tokens.
LLM_MAX_OUTPUT_TOKENS_THINKING=2048
# A cold model load takes ~65 s on a 4 GB GPU, so keep this generous.
LLM_FIRST_TOKEN_TIMEOUT_MS=120000
LLM_TOTAL_TIMEOUT_MS=300000
# Max previous messages considered before the token budget is applied.
CONTEXT_MAX_HISTORY_MESSAGES=20

# --- Memory (RAG) ---
# Served by the CPU-only `ollama-embed` service. Must produce 1024-dimension
# vectors (the column size); another size needs a new migration.
EMBEDDING_MODEL=qwen3-embedding:0.6b
