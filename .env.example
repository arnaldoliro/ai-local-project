# Copy to .env and fill in. Never commit .env.

# --- Postgres (internal to the compose network, no published port) ---
POSTGRES_USER=ai_local
# Use only letters and digits: the value goes into a connection URL.
# Example to generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=ai_local

# --- Model ---
LLM_DEFAULT_MODEL=qwen3.5:2b
# Context window in tokens, applied to Ollama (OLLAMA_CONTEXT_LENGTH) and to
# the backend token budget. Do not raise it without measuring VRAM first.
LLM_CONTEXT_WINDOW=4096
# How long Ollama keeps an idle model in VRAM.
OLLAMA_KEEP_ALIVE=5m
