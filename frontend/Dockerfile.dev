# Development image: dependencies are baked in, source code is bind-mounted
# by docker-compose.yml so `next dev` hot-reloads on every save.
FROM node:24-bookworm-slim

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node . .
# Pre-create .next so the anonymous volume mounted there inherits node ownership.
RUN mkdir -p .next

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

# Bind to all interfaces *inside* the container; the host publishes 127.0.0.1 only.
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
